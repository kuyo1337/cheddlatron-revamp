    </div>
  </nav>

  <!-- 404 CONTENT -->
  <main class="error-main">
    <div class="text-center">
      <div class="error-number">404</div>
      <div class="divider-line"></div>
      <h1 class="error-title">Página não encontrada</h1>
      <p class="error-desc">
        Parece que a página que você está procurando não existe ou foi movida. Mas não se preocupe — a <strong style="color:#f9fafb;">3l</strong> tem muito mais para você explorar.
      </p>
      <div class="d-flex flex-wrap gap-3 justify-content-center">
        <a href="/" class="btn-primary-custom">
          <i class="fa-solid fa-house me-2"></i>Voltar para o Início
        </a>
        <a href="/faq" class="btn-outline-custom">
