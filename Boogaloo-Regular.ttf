          <p class="mt-3" style="font-size:13px;color:var(--text-secondary);">
            <i class="fa-solid fa-envelope me-2" style="color:var(--accent);"></i><a href="/cdn-cgi/l/email-protection" class="__cf_email__" data-cfemail="accfc3c2d8cdd8c3ec9fc082dbd8ca">[email&#160;protected]</a>
