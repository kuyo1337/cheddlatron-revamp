        </div>
        <div class="col-6 col-lg-2">
          <div class="footer-heading">Navegação</div>
          <ul class="footer-links">
            <li><a href="/">Home</a></li>
            <li><a href="/guias">Guias</a></li>
            <li><a href="/bingo">Bingo</a></li>
