        <a href="/slots" class="quick-link"><i class="fa-solid fa-dice"></i>Slots</a>
        <a href="/bingo" class="quick-link"><i class="fa-solid fa-circle-dot"></i>Bingo</a>
        <a href="/apostas-esportivas" class="quick-link"><i class="fa-solid fa-futbol"></i>Apostas Esportivas</a>
        <a href="/jogos-de-cartas" class="quick-link"><i class="fa-solid fa-cards"></i>Jogos de Cartas</a>
        <a href="/dicas" class="quick-link"><i class="fa-solid fa-lightbulb"></i>Dicas</a>
        <a href="/registrar" class="quick-link"><i class="fa-solid fa-user-plus"></i>Cadastrar</a>
        <a href="/login" class="quick-link"><i class="fa-solid fa-right-to-bracket"></i>Login</a>
      </div>
    </div>
  </main>

